APP_ENV=development
HOST=0.0.0.0
PORT=5000
DATABASE_URL=sqlite:///./cybershield.db
REPORT_STORAGE_ROOT=reports/generated
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-characters-long
CORS_ORIGINS=http://localhost:3000
SCANNER_ENABLED=true
SCANNER_CONNECT_TIMEOUT=5
SCANNER_READ_TIMEOUT=10
SCANNER_TOTAL_TIMEOUT=20
SCANNER_MAX_REDIRECTS=3
SCANNER_MAX_RESPONSE_BYTES=200000
SCANNER_MAX_REQUESTS_PER_SCAN=5
SCANNER_MAX_CONCURRENT_SCANS=3
LOG_LEVEL=INFO
